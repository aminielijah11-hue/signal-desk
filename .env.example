# Copy to .env and fill in. Never commit .env — it's gitignored.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# SEC blocks requests without a descriptive User-Agent (PROMPT.md §3):
# "SignalDesk/1.0 (<user's email>)". Used by every SEC EDGAR ingester.
SIGNAL_DESK_CONTACT_EMAIL=you@example.com
